# ---- Públicas (vão para o navegador) ----
# Supabase: Project Settings > API Keys > Publishable key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# Mercado Pago: Suas integrações > sua aplicação > Credenciais > Public Key
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- Secretas (SÓ no servidor: secrets do Codespaces / Cloudflare. Nunca no código.) ----
# Supabase: Project Settings > API Keys > Secret key
SUPABASE_SECRET_KEY=sb_secret_xxx
# Mercado Pago: Credenciais > Access Token
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
# Opcional: endereço público do site, usado para o webhook do Mercado Pago
SITE_URL=https://seu-site.com.br

# Melhor Envio (frete por transportadora). Token: Configurações > Permissões de acesso > Gerar token
MELHOR_ENVIO_TOKEN=xxx
# CEP de onde saem os envios (só no servidor, não aparece no site)
MELHOR_ENVIO_CEP_ORIGEM=24000000
# true = ambiente de teste (sandbox.melhorenvio.com.br). Tire em produção.
MELHOR_ENVIO_SANDBOX=true
